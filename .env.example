# Copiar a .env y completar con valores reales. Nunca commitear el .env real
# (ya está en .gitignore).

# --- Backend (NestJS) ---
# En desarrollo local (Postgres nativo en esta máquina): host 127.0.0.1.
# En docker-compose de producción: host "postgres" (nombre del servicio).
DATABASE_URL="postgresql://postgres:CAMBIAR@127.0.0.1:5432/gestioya?schema=public"

# Generar uno nuevo para cada ambiente con: openssl rand -hex 32
# Nunca reusar el de desarrollo en producción.
JWT_SECRET="CAMBIAR-generar-con-openssl-rand-hex-32"

JWT_ACCESS_EXPIRES="45m"
JWT_REFRESH_DAYS="30"
PORT="3000"

# Origen exacto del frontend (sin barra final). En desarrollo:
# http://localhost:3001. En producción: https://tu-dominio.com
CORS_ORIGIN="http://localhost:3001"

# --- Solo usadas por docker-compose.yml (producción) ---
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CAMBIAR"
POSTGRES_DB="gestioya"
